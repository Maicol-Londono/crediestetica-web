# Autenticación contra Wellezy Hub (solo servidor; NO usar NUXT_PUBLIC_*).
# Producción: https://wellezyhub.com/api  |  Local: http://localhost:8000/api
# Es la URL de la API del Hub; NO es el dominio público del sitio (https://crediestetica.com, ver NUXT_PUBLIC_SITE_URL / site.url).
NUXT_WELLEZY_API_BASE_URL=
# Tenant: empresa y línea de esta web. La línea se envía al Hub con X-Tenant-Linea.
NUXT_WELLEZY_COMPANY_SLUG=legalmed
NUXT_WELLEZY_LINE_SLUG=crediestetica
# Opcional: IDs de rol autorizados para el CMS, separados por coma (vacío = sin IDs; el acceso lo decide la pertenencia a empresa/línea).
NUXT_ADMIN_ROLE_IDS=
# Opcional: ids de rol que pueden ESCRIBIR el contenido local (Nosotros, Clinicas, paginas), ademas de los perfiles reconocidos por nombre.
NUXT_CONTENT_EDITOR_ROLE_IDS=
# Opcional: ids de rol que pueden editar la tasa de financiacion, ademas del lider de la linea.
NUXT_RATE_EDITOR_ROLE_IDS=

# REQUERIDO. Secreto de la cookie de sesión (crediestetica-admin): mínimo 32 caracteres aleatorios, distinto al de cualquier otra web. No lo subas al repositorio.
NUXT_SESSION_PASSWORD=

# Dominio público del sitio (canonical, sitemap, Open Graph).
NUXT_PUBLIC_SITE_URL=https://crediestetica.com

# Contenido administrado localmente (Nosotros, Clinicas, paginas, tasa de financiacion). Directorio PERSISTENTE fuera de .output/.
# Vacio = ./.data/crediestetica-content. Produccion: /var/lib/crediestetica/content (el usuario del proceso debe poder leer y escribir).
NUXT_CONTENT_DIR=

# Proxies de confianza delante de la aplicacion (0 = ignorar X-Forwarded-For). Subir a 1 solo tras confirmar que hay UN proxy (p. ej. Nginx Proxy Manager)
# que anade la IP real al final de X-Forwarded-For y que Node no es alcanzable sin pasar por el.
NUXT_TRUSTED_PROXY_HOPS=0

# Destino del CRM PROPIO de Crediestética para el formulario de valoración («Pide tu cita»). https obligatorio. Vacío o apuntando al CRM
# heredado del clon: el formulario responde 503 y no envía nada.
NUXT_CRM_VALUATION_URL=
# Valores con los que el CRM identifica a Crediestética en cada valoración. SOLO servidor, SIN valor por defecto: los define el responsable del
# CRM (no se reutilizan valores de otro sistema). Si falta o es inválido cualquiera, la valoración responde 503 not_configured y no sale ninguna petición.
# Los tres ids son enteros positivos (sin ceros a la izquierda); estado y origen son texto de hasta 100 caracteres.
NUXT_CRM_VALUATION_USER_ID=
NUXT_CRM_VALUATION_LINE_ID=
NUXT_CRM_VALUATION_ADVISOR_ID=
NUXT_CRM_VALUATION_STATE=
NUXT_CRM_VALUATION_ORIGIN=

# ── NECESARIAS PARA EL FORMULARIO «ESTUDIO DE CRÉDITOS» (envío por correo SMTP) ──────────────────────────────────────────────────────────
# Las define el administrador en el servidor; NUNCA se suben al repositorio ni se escriben en este archivo de ejemplo. Sin ellas el formulario
# responde 503 y no envía nada. Conexión cifrada obligatoria: puerto 465 (TLS) o 587 (STARTTLS). SOLO servidor (no usar NUXT_PUBLIC_*).
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=
NUXT_MAIL_USERNAME=
NUXT_MAIL_PASSWORD=
# Remitente. Si queda vacío se usa NUXT_MAIL_USERNAME cuando es un correo. Con muchos proveedores debe coincidir con la cuenta autenticada.
NUXT_MAIL_FROM_ADDRESS=
NUXT_MAIL_FROM_NAME=Crediestética
# Destinatarios del estudio de crédito. OPCIONALES: los valores por defecto (creditStudyTo / creditStudyCc en nuxt.config.ts) ya son los definidos
# para Crediestética. Solo se definen aquí para sustituirlos; varias direcciones separadas por coma.
# NUXT_CREDIT_STUDY_TO=
# NUXT_CREDIT_STUDY_CC=
# Solicitud de financiación (LeadForm): mismos criterios. Opcionales; varias direcciones separadas por coma.
# NUXT_LEAD_FORM_TO=
# NUXT_LEAD_FORM_CC=
# Correo de respaldo de valoración y notificación complementaria de referidos (NO sustituyen al CRM ni a Hub). Opcionales; varias direcciones separadas por coma.
# NUXT_VALUATION_TO=
# NUXT_VALUATION_CC=
# NUXT_REFERRAL_TO=
# NUXT_REFERRAL_CC=
