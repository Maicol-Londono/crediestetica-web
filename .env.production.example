# Plantilla de variables de PRODUCCIÓN de Crediestética. SIN secretos ni valores asumidos: copiar a la configuración del proceso del servidor
# (no al repositorio) y completar cada valor marcado como PENDIENTE. Inventario y notas: docs/despliegue/guia-despliegue-crediestetica.md.
# Nitro/Nuxt lee estas variables del ENTORNO del proceso al arrancar (el build no las incorpora): cambiarlas exige reiniciar el proceso.

# ── OBLIGATORIAS ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# URL de la API de Wellezy Hub de PRODUCCIÓN (solo servidor). PENDIENTE de confirmar. No es el dominio público del sitio.
NUXT_WELLEZY_API_BASE_URL=

# Tenant por SLUG (nunca por id). Valores de referencia verificados contra la copia local del Hub; CONFIRMAR contra producción.
NUXT_WELLEZY_COMPANY_SLUG=legalmed
NUXT_WELLEZY_LINE_SLUG=crediestetica

# Secreto de sesión (cookie `crediestetica-admin`) y de la clave de idempotencia de inscripciones: mínimo 32 caracteres aleatorios,
# NUEVO y distinto del de cualquier otra web. Generarlo en el servidor y no versionarlo. Sin él el panel no puede iniciar sesión.
NUXT_SESSION_PASSWORD=

# Dominio público (canonical, sitemap, Open Graph). Valor confirmado por el responsable del sitio.
NUXT_PUBLIC_SITE_URL=https://crediestetica.com

# Directorio PERSISTENTE del contenido local (Nosotros, Clínicas, páginas, tasa de financiación): fuera de `.output/` y con permiso de
# lectura y escritura para el usuario del proceso. Valor sugerido por el proyecto: /var/lib/crediestetica/content. CONFIRMAR en el servidor.
# Si queda vacío usa <directorio de trabajo>/.data/crediestetica-content, que se pierde si el despliegue reemplaza la carpeta.
NUXT_CONTENT_DIR=

# ── NECESARIA PARA EL FORMULARIO DE VALORACIÓN («Pide tu cita») ─────────────────────────────────────────────────────────────────────────
# Destino del CRM PROPIO de Crediestética (https). PENDIENTE. El código NO trae destino por defecto (el CRM heredado de Planmed se retiró) y
# además BLOQUEA ese endpoint heredado si alguien lo define: mientras esta variable no tenga un destino propio válido, el formulario responde
# 503 y no envía nada.
NUXT_CRM_VALUATION_URL=
# Identificadores y textos con los que el CRM reconoce a Crediestética (SOLO servidor, SIN valor por defecto). PENDIENTES: los confirma el
# responsable del CRM; los valores de Planmed NO se reutilizan. Si falta o es inválido cualquiera, la valoración responde 503 not_configured.
# Ids: enteros positivos sin ceros a la izquierda. Estado y origen: texto de hasta 100 caracteres.
NUXT_CRM_VALUATION_USER_ID=
NUXT_CRM_VALUATION_LINE_ID=
NUXT_CRM_VALUATION_ADVISOR_ID=
NUXT_CRM_VALUATION_STATE=
NUXT_CRM_VALUATION_ORIGIN=

# ── NECESARIAS PARA EL FORMULARIO «ESTUDIO DE CRÉDITOS» (envío por correo SMTP) ──────────────────────────────────────────────────────────
# Las define el administrador en el servidor; NUNCA se suben al repositorio ni se escriben en este archivo de ejemplo. Sin ellas el formulario
# responde 503 y no envía nada. Conexión cifrada obligatoria: puerto 465 (TLS) o 587 (STARTTLS). SOLO servidor (no usar NUXT_PUBLIC_*).
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=
NUXT_MAIL_USERNAME=
NUXT_MAIL_PASSWORD=
# Remitente. Si queda vacío se usa NUXT_MAIL_USERNAME cuando es un correo. Con muchos proveedores debe coincidir con la cuenta autenticada.
NUXT_MAIL_FROM_ADDRESS=
NUXT_MAIL_FROM_NAME=Crediestética
# Destinatarios del estudio de crédito. OPCIONALES: los valores por defecto (creditStudyTo / creditStudyCc en nuxt.config.ts) ya son los definidos
# para Crediestética. Solo se definen aquí para sustituirlos; varias direcciones separadas por coma.
# NUXT_CREDIT_STUDY_TO=
# NUXT_CREDIT_STUDY_CC=
# Solicitud de financiación (LeadForm): mismos criterios. Opcionales; varias direcciones separadas por coma.
# NUXT_LEAD_FORM_TO=
# NUXT_LEAD_FORM_CC=
# Correo de respaldo de valoración y notificación complementaria de referidos (NO sustituyen al CRM ni a Hub). Opcionales; varias direcciones separadas por coma.
# NUXT_VALUATION_TO=
# NUXT_VALUATION_CC=
# NUXT_REFERRAL_TO=
# NUXT_REFERRAL_CC=

# ── DEBEN PERMANECER VACÍAS (sin decisión del negocio) ───────────────────────────────────────────────────────────────────────────────────
# Roles adicionales que pueden editar la tasa de financiación. Vacío: solo el superadmin global y el líder de área.
NUXT_RATE_EDITOR_ROLE_IDS=
# Roles adicionales (opcional) que escriben el contenido local. Vacío: solo los perfiles reconocidos por nombre.
NUXT_CONTENT_EDITOR_ROLE_IDS=
# No interviene en el acceso al panel (lo decide la pertenencia a la empresa y línea). Vacío.
NUXT_ADMIN_ROLE_IDS=

# ── OPCIONALES CON VALOR POR DEFECTO ─────────────────────────────────────────────────────────────────────────────────────────────────────
# 0 = ignorar X-Forwarded-For (seguro). Subir a 1 SOLO tras confirmar que hay UN proxy que añade la IP real y que Node no es alcanzable sin él.
# La cadena real de proxies está SIN CONFIRMAR: no asumir 1.
NUXT_TRUSTED_PROXY_HOPS=0

# ── OPCIONAL (PRP habilitado: usa el endpoint compartido por defecto) ────────────────────────────────────────────────────────────────────────────────────────────────
# NUXT_PUBLIC_CRM_PRP_FORM_URL: no hace falta definirla; el valor por defecto (nuxt.config.ts) es el endpoint compartido aprobado. Interruptores en shared/utils/features.ts.
# Variables de Planmed que YA NO se usan y deben retirarse del servidor: NUXT_PLANMED_ADMIN_ROLE_IDS, NUXT_PLANMED_CONTENT_EDITOR_ROLE_IDS,
# NUXT_PLANMED_CONTENT_DIR, NUXT_PLANMED_RATE_EDITOR_ROLE_IDS.
